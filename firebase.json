{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.txt",
      "*.md"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
